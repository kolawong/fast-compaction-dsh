{
  "name": "fast-compaction-dsh",
  "description": "Verdict-based compaction engine for DeepSeek Harness: replaces the lossy compaction summary with fast per-call keep/truncate/drop decisions, keeping everything else verbatim (port of tamaratran/fast-jev-compaction)",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "author": "kolawong",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "compaction",
    "context-management",
    "jev",
    "typesafe",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolawong/fast-compaction-dsh.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "inspect:compaction": "node scripts/inspect-compaction.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-compaction": "link:../deepseek-harness/packages/compaction/compaction",
    "@deepseek-ai/dsh-compaction-basic": "link:../deepseek-harness/packages/compaction/compaction-basic",
    "@deepseek-ai/dsh-settings": "link:../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-settings-file": "link:../deepseek-harness/packages/settings/settings-file",
    "@deepseek-ai/dsh-token-meter": "link:../deepseek-harness/packages/llm/token-meter",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
