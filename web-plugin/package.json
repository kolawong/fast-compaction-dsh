{
  "name": "dsh-plugin-fast-compaction",
  "version": "0.1.0",
  "description": "DeepSeek Harness web-profile plugin: settings card + settings namespace for the fast-compaction-dsh agent-side cordis compaction engine.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "settings",
    "compaction",
    "fast-compaction"
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "@deepseek-ai/dsh-settings": "*"
  }
}
